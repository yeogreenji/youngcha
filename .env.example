# 영차 YOUNGCHA — 환경 변수 예시
#
# 이 파일은 '이름과 쓰임'만 알려 주는 예시입니다. 실제 값은 여기에도, 저장소에도
# 절대 커밋하지 않습니다. Vercel 프로젝트 설정의 Environment Variables에만 넣습니다.
# (지침 Ⅴ: 비밀번호·API 키·관리자 비밀 키는 공개 저장소나 프런트엔드에 넣지 않는다)
#
# 뼈대(v0.1.0)에서는 아래 값이 모두 비어 있어도 앱이 그대로 동작합니다.
# 비어 있으면 화면은 '샘플/미연결' 상태로 표시됩니다.

# ── 지금 쓰는 값 ────────────────────────────────────────────────────────────
# 없음. /api/health 는 MARKET_DATA_API_KEY·CHAT_DATABASE_URL 의 '설정 여부'만
# 불리언으로 알려 줍니다. 값 자체는 어떤 응답에도 담기지 않습니다.

# ── 시세·종목 데이터 (연결 예정, 사용자 승인 후) ─────────────────────────────
MARKET_DATA_API_KEY=
MARKET_DATA_PROVIDER=

# ── 채팅·계정 (연결 예정) ──────────────────────────────────────────────────
# 실제 이용자 간 채팅을 붙일 때의 서버 전용 DB 주소. 프런트엔드에는 노출하지 않습니다.
CHAT_DATABASE_URL=
# 세션/토큰 서명 키. 배포 시 임의의 긴 문자열로 설정합니다.
AUTH_SECRET=

# ── 선택: 분석 문구 생성 (연결 예정) ────────────────────────────────────────
# '쉬운 말 분석' 문장을 생성형 모델로 만들 때만 사용합니다.
# 숫자·시세는 반드시 별도 데이터 소스에서 오고, 이 키로 만들지 않습니다.
ANALYSIS_MODEL_API_KEY=

# ── 운영 메모 ──────────────────────────────────────────────────────────────
# 프런트엔드에 노출되는 값(VITE_*)에는 비밀을 넣지 않습니다.
# 지금 프런트엔드는 어떤 VITE_* 값도 읽지 않습니다.
